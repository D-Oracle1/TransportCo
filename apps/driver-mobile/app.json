{
  "expo": {
    "name": "TransportCo Driver",
    "slug": "transportco-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "transportcodriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "resizeMode": "contain", "backgroundColor": "#12454d" },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transportco.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shared with operations and your customer while you are on a trip.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location keeps your customer updated while you drive to them.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.transportco.driver",
      "adaptiveIcon": { "backgroundColor": "#12454d" },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Background location keeps your customer updated while you drive to them.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
