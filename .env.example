# ============================================================================
# TransportCo — environment configuration template
# Copy to `.env` and fill in. NEVER commit a populated .env file.
# Every variable is validated at boot by packages/config (fail-fast).
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
API_PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug                      # fatal|error|warn|info|debug|trace
# Comma-separated list of allowed browser origins for the admin console.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL 14+)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transportco
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth
# JWT_SECRET must be >= 32 chars. Generate: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# Supabase (optional in Phase 1 — the API ships a first-party auth provider.
# Set AUTH_PROVIDER=supabase to delegate identity to Supabase instead.)
AUTH_PROVIDER=local                  # local | supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Maps / geo
# Server key: unrestricted-by-referrer, IP-restricted, Directions+Geocoding.
# Client keys are separate, platform-restricted keys.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROVIDER=mock            # mock | google
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_DEFAULT=mock        # mock | paystack | flutterwave
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_CURRENCY=NGN

# ---------------------------------------------------------------------------
# Notifications (channel adapters; unset providers fall back to the log driver)
# ---------------------------------------------------------------------------
NOTIFICATIONS_DRIVER=log             # log | live
EXPO_PUSH_ACCESS_TOKEN=
SMS_PROVIDER=none                    # none | termii | twilio
SMS_API_KEY=
SMS_SENDER_ID=TransportCo
EMAIL_PROVIDER=none                  # none | resend | smtp
EMAIL_API_KEY=
EMAIL_FROM=no-reply@transportco.example
WHATSAPP_PROVIDER=none               # none | meta
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Realtime
# ---------------------------------------------------------------------------
REALTIME_DRIVER=socketio             # socketio | supabase
REALTIME_PATH=/realtime

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
OPS_EMERGENCY_HOTLINE=+2340000000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Client apps
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
